# Local, machine-specific configuration. Contains credentials — never committed.
/config/config.local.php

# Runtime state written by the app. Lives outside public/ and is recreated on
# demand. Includes var/sessions, var/imports (uploaded rosters — PII) and
# var/mail, where the 'file' mail transport writes .eml files during
# development instead of delivering them.
/var/

# Roster exports and sample data. Real rosters carry ~1,950 people's home
# addresses, phone numbers and emails — they do not belong in a public
# repository under any circumstances.
/data/
*.xls
*.xlsx
*.csv

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Composer is deliberately unused (see CLAUDE.md); guard against a stray install
/vendor/
composer.lock
